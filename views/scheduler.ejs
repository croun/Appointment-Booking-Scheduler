                            <button type="button" @click="adminStatusFilter = 'confirmed'; loadAdminData()" :class="adminStatusFilter === 'confirmed' ? 'bg-teal-700 text-white font-bold' : 'bg-slate-100 text-slate-600'" class="px-2 py-0.5 rounded">Confirmed</button>
                            <button type="button" @click="adminStatusFilter = 'serving'; loadAdminData()" :class="adminStatusFilter === 'serving' ? 'bg-emerald-600 text-white font-bold' : 'bg-slate-100 text-slate-600'" class="px-2 py-0.5 rounded">Serving</button>
                            <button type="button" @click="adminStatusFilter = 'completed'; loadAdminData()" :class="adminStatusFilter === 'completed' ? 'bg-slate-700 text-white font-bold' : 'bg-slate-100 text-slate-600'" class="px-2 py-0.5 rounded">Done</button>
                        </div>
                    </div>
                    
                    <input type="text" x-model="adminSearchQuery" @input.debounce.300ms="loadAdminData()" placeholder="Search ref, name, phone..." class="text-xs rounded-md border-slate-200 py-1 px-2 w-52">
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] border-b border-slate-200">
                            <tr>
                                <th class="py-2 px-3">Queue #</th>
                                <th class="py-2 px-3">Ref</th>
                                <th class="py-2 px-3">Time</th>
                                <th class="py-2 px-3">Client</th>
                                <th class="py-2 px-3">Service</th>
                                <th class="py-2 px-3">Provider</th>
                                <th class="py-2 px-3">Status</th>
                                <th class="py-2 px-3 text-right">Queue Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <template x-for="apt in adminAppointments" :key="apt.id">
                                <tr class="hover:bg-slate-50/80">
                                    <td class="py-2 px-3">
                                        <span class="font-mono font-bold px-2 py-0.5 bg-teal-50 text-teal-800 rounded border border-teal-200" x-text="apt.queue_number || '—'"></span>
                                    </td>
                                    <td class="py-2 px-3 font-mono font-bold text-slate-700" x-text="apt.reference_code"></td>
                                    <td class="py-2 px-3 font-semibold" x-text="formatTimeWindow(apt.starts_at, apt.ends_at)"></td>
                                    <td class="py-2 px-3">
                                        <div class="font-semibold" x-text="apt.customer_name"></div>
                                        <div class="text-[10px] text-slate-400" x-text="apt.customer_phone"></div>
                                    </td>
                                    <td class="py-2 px-3" x-text="apt.service?.name"></td>
                                    <td class="py-2 px-3" x-text="apt.provider?.name"></td>
                                    <td class="py-2 px-3">
                                        <span :class="getStatusBadgeClass(apt.status)" class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase" x-text="apt.status"></span>
                                    </td>
                                    <td class="py-2 px-3 text-right space-x-1.5">
                                        <!-- Call next / Serving -->
                                        <button type="button"
                                                x-show="apt.status === 'confirmed'"
                                                @click="updateAppointmentStatus(apt.id, 'serving')"
                                                class="px-2 py-0.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-[11px] font-semibold transition">
                                            Call / Serving
                                        </button>

                                        <!-- Mark Complete -->
                                        <button type="button"
                                                x-show="apt.status === 'serving' || apt.status === 'confirmed'"
                                                @click="updateAppointmentStatus(apt.id, 'completed')"
                                                class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-emerald-800 rounded text-[11px] font-semibold transition">
                                            Done
                                        </button>

                                        <!-- Mark No-Show -->
                                        <button type="button"
                                                x-show="apt.status === 'confirmed' || apt.status === 'serving'"
                                                @click="updateAppointmentStatus(apt.id, 'no_show')"
                                                class="text-amber-600 hover:underline text-[11px] font-medium">
                                            No-Show
                                        </button>

                                        <!-- Cancel -->
                                        <button type="button"
                                                x-show="apt.status !== 'cancelled' && apt.status !== 'completed'"
                                                @click="updateAppointmentStatus(apt.id, 'cancelled')"
                                                class="text-rose-600 hover:underline text-[11px] font-medium">
                                            Cancel
                                        </button>
                                    </td>
                                </tr>
                            </template>
                            <template x-if="adminAppointments.length === 0">
                                <tr>
                                    <td colspan="8" class="py-8 text-center text-slate-400">No appointments found for the selected filter.</td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </main>


    <!-- ==================================================================== -->
    <!-- MODALS: Review, Confirmation, Lookup, Guest Manage, Waitlist          -->
    <!-- ==================================================================== -->

    <!-- 1. Review & Confirm Summary Screen Modal -->
    <div x-show="isReviewModalOpen"
         x-transition
         class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
        <div @click.away="isReviewModalOpen = false" class="bg-white rounded-2xl max-w-md w-full p-4 sm:p-6 shadow-2xl max-h-[92vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full">Step 4: Final Review</span>
                    <h3 class="text-sm font-bold text-slate-900 mt-1">Review Your Appointment Details</h3>
                </div>
                <button type="button" @click="isReviewModalOpen = false" class="text-slate-400 hover:text-slate-600">✕</button>
            </div>

            <!-- Booking details card -->
            <div class="p-3 bg-slate-50 rounded-xl text-xs space-y-2 border border-slate-200">
                <div class="flex justify-between">
                    <span class="text-slate-500">Service:</span>
                    <strong class="text-slate-900" x-text="selectedService?.name"></strong>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Practitioner:</span>
                    <strong class="text-slate-900" x-text="selectedSlot?.provider_name || 'Assigned Specialist'"></strong>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Date & Slot:</span>
                    <strong class="text-teal-700" x-text="formattedSelectedDate + ' at ' + selectedSlot?.time"></strong>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Total Due:</span>
                    <strong class="text-teal-900" x-text="formatCurrency(selectedService?.price)"></strong>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Guest Name:</span>
                    <span class="font-medium text-slate-800" x-text="form.customer_name"></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Contact:</span>
                    <span class="font-mono text-slate-700" x-text="form.customer_email + ' • ' + form.customer_phone"></span>
                </div>
            </div>

            <p class="text-[11px] text-slate-500 mt-3">
                Upon submitting, your appointment will be atomically booked and a unique <strong>daily queue number</strong> will be generated.
            </p>

            <div class="mt-4 flex space-x-2">
                <button type="button"
                        @click="submitBooking()"
                        :disabled="isSubmittingBooking"
                        class="flex-1 py-2 bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs rounded-lg transition shadow-xs flex items-center justify-center space-x-1.5">
                    <span x-show="!isSubmittingBooking">Confirm & Generate Queue Number</span>
                    <span x-show="isSubmittingBooking">Reserving Slot...</span>
                </button>
                <button type="button" @click="isReviewModalOpen = false" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition">Back</button>
            </div>
        </div>
    </div>


    <!-- 2. Confirmation Modal with Queue Number & Manage Link -->
    <div x-show="isConfirmationModalOpen"
         x-transition
         class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
        
        <div @click.away="isConfirmationModalOpen = false" class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl text-center max-h-[92vh] overflow-y-auto">
            
            <!-- Success icon -->
            <div class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-2xl flex items-center justify-center mx-auto mb-2">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <h3 class="text-base font-bold text-slate-900">Appointment Scheduled!</h3>
            <p class="text-xs text-slate-500">Your slot is reserved. A confirmation email and SMS have been dispatched.</p>

            <!-- QUEUE NUMBER TICKET -->
            <div class="mt-4 p-4 bg-gradient-to-br from-teal-50 to-emerald-50 border-2 border-teal-500/40 rounded-2xl shadow-sm text-center relative overflow-hidden">
                <div class="text-[10px] uppercase font-bold tracking-widest text-teal-700 mb-1">Your Daily Queue Number</div>
                <div class="text-4xl font-black font-mono tracking-tight text-teal-900" x-text="confirmedAppointment?.queue_number || 'A-001'"></div>
                <div class="text-[10px] text-teal-600 font-medium mt-1">Resets daily • Arrival order for your session</div>

                <div class="mt-3 pt-3 border-t border-teal-200/60 grid grid-cols-2 gap-2 text-left text-xs">
                    <div>
                        <span class="text-[10px] text-slate-500 block">Reference Code</span>
                        <strong class="font-mono text-slate-800" x-text="confirmedAppointment?.reference_code"></strong>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-500 block">Service</span>
                        <strong class="text-slate-800 truncate block" x-text="confirmedAppointment?.service?.name"></strong>
                    </div>
                </div>
            </div>

            <!-- Self-Service Manage Link Card (No Login) -->
            <div class="mt-3 p-3 bg-slate-50 rounded-xl text-left text-xs border border-slate-200 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="font-semibold text-slate-700">Self-Service Manage Link:</span>
                    <span class="text-[10px] text-slate-400">No account required</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <input type="text"
                           readonly
                           :value="confirmedManageUrl"
                           class="flex-1 text-[11px] font-mono bg-white border border-slate-200 rounded px-2 py-1 text-slate-600 truncate">
                    <button type="button"
                            @click="copyManageUrl()"
                            class="px-2.5 py-1 bg-slate-900 text-white rounded text-[11px] font-semibold hover:bg-slate-800 transition">
                        <span x-text="manageCopied ? 'Copied!' : 'Copy'"></span>
                    </button>
                </div>
                <div class="text-[10px] text-slate-500">
                    Use this private link anytime to view, reschedule, or cancel your booking.
                </div>
            </div>

            <!-- Calendar & .ICS actions -->
            <div class="mt-3 grid grid-cols-2 gap-2">
                <a :href="confirmedAppointmentGoogleUrl" target="_blank" class="py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-semibold transition text-center">Google Calendar</a>
                <a :href="'/api/appointments/' + confirmedAppointment?.reference_code + '/ics'" download class="py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-semibold transition text-center">Download .ICS</a>
            </div>

            <button type="button" @click="isConfirmationModalOpen = false; resetBookingFlow()" class="w-full mt-3 py-2 bg-teal-600 text-white rounded-lg text-xs font-bold hover:bg-teal-700 transition">
                Done
            </button>
        </div>
    </div>


    <!-- Lookup Modal (Lost email / link recovery) -->
    <div x-show="isLookupModalOpen" x-transition class="fixed inset-0 z-50 bg-slate-900/60 flex items-center justify-center p-3 sm:p-4">
        <div @click.away="isLookupModalOpen = false" class="bg-white rounded-2xl max-w-md w-full p-4 sm:p-5 shadow-2xl max-h-[92vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-2">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Look Up Your Booking</h3>
                    <p class="text-xs text-slate-500">Find your schedule and queue number using your reference code and contact info.</p>
                </div>
                <button type="button" @click="isLookupModalOpen = false" class="text-slate-400">✕</button>
            </div>

            <form @submit.prevent="performLookup()" class="space-y-2 mt-3">
                <input type="text"
                       x-model="lookupRefCode"
                       required
                       placeholder="Booking Reference Code (e.g. APT-7X9K2M)"
                       class="w-full uppercase font-mono text-base sm:text-xs rounded-lg border-slate-300 py-2 sm:py-1.5">
                
                <input type="text"
                       x-model="lookupContact"
                       required
                       placeholder="Email Address or Phone Number used during booking"
                       class="w-full text-base sm:text-xs rounded-lg border-slate-300 py-2 sm:py-1.5">

                <template x-if="lookupError">
                    <div class="p-2 text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg" x-text="lookupError"></div>
                </template>

                <button type="submit"
                        :disabled="isLookingUp"
                        class="w-full py-2.5 sm:py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-lg transition">
                    <span x-show="!isLookingUp">Find Booking</span>
                    <span x-show="isLookingUp">Locating...</span>
                </button>
            </form>

            <!-- Found appointment display -->
            <template x-if="foundAppointment">
                <div class="mt-4 p-3.5 bg-slate-50 rounded-xl text-xs space-y-2 border border-slate-200">
                    <div class="flex justify-between items-center">
                        <span class="font-mono font-bold text-sm text-slate-900" x-text="foundAppointment.reference_code"></span>
                        <span :class="getStatusBadgeClass(foundAppointment.status)" class="px-2 py-0.5 rounded-full text-[9px] uppercase font-bold" x-text="foundAppointment.status"></span>
                    </div>

                    <div class="p-2 bg-teal-50 border border-teal-200 rounded-lg flex items-center justify-between">
                        <span class="text-[11px] text-teal-800">Queue Ticket:</span>
                        <span class="font-mono font-bold text-sm text-teal-900" x-text="foundAppointment.queue_number || 'A-001'"></span>
                    </div>

                    <div><strong>Service:</strong> <span x-text="foundAppointment.service?.name"></span></div>
                    <div><strong>Practitioner:</strong> <span x-text="foundAppointment.provider?.name"></span></div>
                    <div><strong>Time:</strong> <span x-text="formatDateTime(foundAppointment.starts_at)"></span></div>

                    <div class="pt-2 border-t border-slate-200/80 flex space-x-2">
                        <button type="button"
                                @click="openManageModalFromAppointment(foundAppointment)"
                                class="flex-1 py-2 sm:py-1.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-lg text-xs transition">
                            Open Self-Service Manager
                        </button>
                    </div>
                </div>
            </template>
        </div>
    </div>


    <!-- 5. Guest Manage Booking Modal (No Login Required) -->
    <div x-show="isGuestManageModalOpen" x-transition class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
        <div @click.away="isGuestManageModalOpen = false" class="bg-white rounded-2xl max-w-md w-full p-4 sm:p-6 shadow-2xl max-h-[92vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Manage Your Booking (Guest Portal)</h3>
                    <p class="text-[11px] text-slate-500">View, reschedule, or cancel without logging in</p>
                </div>
                <button type="button" @click="isGuestManageModalOpen = false" class="text-slate-400 hover:text-slate-600">✕</button>
            </div>

            <template x-if="guestAppointment">
                <div class="space-y-3">
                    
                    <!-- Ticket Pill -->
                    <div class="p-3 bg-teal-50 border border-teal-200 rounded-xl flex items-center justify-between">
                        <div>
                            <span class="text-[10px] text-teal-700 font-bold uppercase block">Daily Queue Ticket</span>
                            <span class="font-mono text-2xl font-black text-teal-900" x-text="guestAppointment.queue_number || 'A-001'"></span>
                        </div>
                        <div class="text-right">
                            <span :class="getStatusBadgeClass(guestAppointment.status)" class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase" x-text="guestAppointment.status"></span>
                            <span class="text-[10px] text-slate-400 block mt-1 font-mono" x-text="guestAppointment.reference_code"></span>
                        </div>
                    </div>

                    <!-- Booking Specs -->
                    <div class="p-3 bg-slate-50 rounded-xl text-xs space-y-1.5 border border-slate-200">
                        <div><strong>Service:</strong> <span x-text="guestAppointment.service?.name"></span></div>
                        <div><strong>Practitioner:</strong> <span x-text="guestAppointment.provider?.name"></span></div>
                        <div><strong>Scheduled For:</strong> <span x-text="formatDateTime(guestAppointment.starts_at)"></span></div>
                        <div><strong>Guest Contact:</strong> <span x-text="guestAppointment.customer_name + ' • ' + guestAppointment.customer_phone"></span></div>
                    </div>

                    <!-- Reschedule Picker Section -->
                    <div x-show="isRescheduleActive" x-transition class="p-3 bg-slate-100 rounded-xl text-xs space-y-2">
                        <span class="font-bold text-slate-800 block text-xs">Select New Date & Time Slot</span>
                        <input type="datetime-local" x-model="rescheduleNewDateTime" class="w-full text-base sm:text-xs rounded border-slate-300 py-1.5">
                        <div class="flex space-x-2">
                            <button type="button" @click="confirmReschedule()" class="flex-1 py-2 sm:py-1.5 bg-teal-600 text-white font-bold rounded text-xs hover:bg-teal-700">Submit Reschedule</button>
                            <button type="button" @click="isRescheduleActive = false" class="px-3 py-1.5 bg-white text-slate-700 rounded text-xs border border-slate-200">Cancel</button>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="pt-2 flex flex-col space-y-2">
                        <template x-if="guestAppointmentCanBeModified && guestAppointment.status === 'confirmed'">
                            <div class="grid grid-cols-2 gap-2">
                                <button type="button"
                                        @click="isRescheduleActive = !isRescheduleActive"
                                        class="py-2.5 sm:py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-lg transition text-center">
                                    Reschedule Slot
                                </button>
                                <button type="button"
                                        @click="cancelGuestBooking()"
                                        class="py-2.5 sm:py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs rounded-lg transition text-center">
                                    Cancel Booking
                                </button>
                            </div>
                        </template>

                        <div class="flex space-x-2">
                            <a :href="guestGoogleUrl" target="_blank" class="flex-1 py-2 sm:py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-md text-center text-xs font-semibold">Google Calendar</a>
                            <a :href="'/api/appointments/' + guestAppointment.reference_code + '/ics'" download class="flex-1 py-2 sm:py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-md text-center text-xs font-semibold">Download .ICS</a>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </div>


    <!-- 6. Priority Waitlist Modal -->
    <div x-show="isWaitlistModalOpen" x-transition class="fixed inset-0 z-50 bg-slate-900/60 flex items-center justify-center p-3 sm:p-4">
        <div @click.away="isWaitlistModalOpen = false" class="bg-white rounded-2xl max-w-sm w-full p-4 sm:p-5 shadow-2xl max-h-[92vh] overflow-y-auto">
            <h3 class="text-sm font-bold text-slate-900">Join Priority Waitlist</h3>
            <p class="text-xs text-slate-500 mt-0.5">We will notify you immediately if a slot opens on this date.</p>
            <form @submit.prevent="submitWaitlist()" class="mt-3 space-y-2 text-xs">
                <div>
                    <label class="block text-[10px] font-semibold text-slate-600 mb-0.5">Preferred Time Window</label>
                    <select x-model="waitlistForm.preferred_time" class="w-full text-base sm:text-xs rounded border-slate-300 py-1.5">
                        <option value="anytime">Any Time</option>
                        <option value="morning">Morning (AM)</option>
                        <option value="afternoon">Afternoon (PM)</option>
                    </select>
                </div>
                <input type="text" x-model="waitlistForm.customer_name" required placeholder="Full Name *" class="w-full text-base sm:text-xs rounded border-slate-300 py-2 sm:py-1.5">
                <input type="email" x-model="waitlistForm.customer_email" required placeholder="Email Address *" class="w-full text-base sm:text-xs rounded border-slate-300 py-2 sm:py-1.5">
                <input type="tel" x-model="waitlistForm.customer_phone" required placeholder="Phone Number *" class="w-full text-base sm:text-xs rounded border-slate-300 py-2 sm:py-1.5">
                
                <div class="flex space-x-2 pt-1">
                    <button type="submit" class="flex-1 py-2 sm:py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded text-xs transition">Join Waitlist</button>
                    <button type="button" @click="isWaitlistModalOpen = false" class="px-3 py-1.5 bg-slate-100 rounded text-xs">Cancel</button>
                </div>
            </form>
        </div>
    </div>


    <!-- 7. Admin Block Time Window Modal -->
    <div x-show="isBlockTimeModalOpen" x-transition class="fixed inset-0 z-50 bg-slate-900/60 flex items-center justify-center p-3 sm:p-4">
        <div @click.away="isBlockTimeModalOpen = false" class="bg-white rounded-2xl max-w-sm w-full p-4 sm:p-5 shadow-2xl max-h-[92vh] overflow-y-auto">
            <h3 class="text-sm font-bold text-slate-900">Block Time Window</h3>
            <p class="text-[11px] text-slate-500">Prevent booking during staff meetings or facility maintenance.</p>
            <form @submit.prevent="submitBlockTime()" class="mt-3 space-y-2 text-xs">
                <input type="text" x-model="blockTimeForm.title" required placeholder="Reason / Title *" class="w-full text-base sm:text-xs rounded border-slate-300 py-2 sm:py-1.5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <input type="datetime-local" x-model="blockTimeForm.starts_at" required class="w-full text-base sm:text-xs rounded border-slate-300 py-1.5">
                    <input type="datetime-local" x-model="blockTimeForm.ends_at" required class="w-full text-base sm:text-xs rounded border-slate-300 py-1.5">
                </div>
                <div class="flex space-x-2 pt-1">
                    <button type="submit" class="flex-1 py-2 sm:py-1.5 bg-slate-900 text-white font-bold rounded text-xs">Save Blockout</button>
                    <button type="button" @click="isBlockTimeModalOpen = false" class="px-3 py-1.5 bg-slate-100 rounded text-xs">Cancel</button>
                </div>
            </form>
        </div>
    </div>


    <!-- 8. Simulated Notifications Drawer (Email & SMS) -->
    <div x-show="isNotificationDrawerOpen" x-transition class="fixed inset-0 z-50 bg-slate-900/40 flex justify-end">
        <div @click.away="isNotificationDrawerOpen = false" class="w-full max-w-sm bg-white h-full shadow-2xl p-4 flex flex-col justify-between overflow-y-auto">
            <div>
                <div class="flex justify-between items-center pb-2 border-b border-slate-100 mb-3">
                    <div>
                        <span class="text-sm font-bold text-slate-900">Simulated Alerts</span>
                        <span class="text-[10px] text-slate-400 block">Customer Email & SMS notifications</span>
                    </div>
                    <button type="button" @click="isNotificationDrawerOpen = false" class="text-slate-400 hover:text-slate-600">✕</button>
                </div>
                <div class="space-y-2">
                    <template x-for="(notif, idx) in notifications" :key="idx">
                        <div class="p-2.5 rounded-lg border text-xs" :class="notif.channel === 'sms' ? 'bg-sky-50/50 border-sky-200' : 'bg-slate-50 border-slate-200'">
                            <div class="flex justify-between items-center mb-0.5">
                                <span class="font-bold text-[10px] uppercase text-slate-500" x-text="notif.channel === 'sms' ? '📱 SMS Message' : '✉️ Email Notification'"></span>
                                <span class="text-[9px] text-slate-400" x-text="notif.time || 'Just now'"></span>
                            </div>
                            <div class="font-semibold text-slate-900" x-text="notif.subject"></div>
                            <div class="text-[11px] text-slate-600 font-mono mt-1 whitespace-pre-line" x-text="notif.body"></div>
                        </div>
                    </template>
                </div>
            </div>
            <button type="button" @click="notifications = []" class="w-full py-1.5 bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-200 transition">Clear Alerts</button>
        </div>
    </div>


    <!-- ==================================================================== -->
    <!-- Alpine.js Client-Side Application State                              -->
    <!-- ==================================================================== -->
    <script>
        function schedulerApp() {
            return {
                activeView: 'client', // 'client' | 'queue' | 'admin'
                mobileStep: 1, // 1: Service, 2: Schedule (Calendar + Slots), 3: Details & Confirm
                initialManageToken: '<%- initialManageToken || "" %>',
                
                services: <%- JSON.stringify(services) %>,
                providers: <%- JSON.stringify(providers) %>,
                holidays: <%- JSON.stringify(holidays) %>,
                selectedTimezone: '<%- defaultTimezone %>',

                selectedService: null,
                selectedProvider: null,
                selectedDate: null,
                formattedSelectedDate: '',
                selectedSlot: null,
                isRecurring: false,
                recurringWeeks: 2,

                calendarYear: new Date().getFullYear(),
                calendarMonth: new Date().getMonth() + 1,
                calendarMonthName: '',
                calendarDays: {},
                calendarDaysList: [],
                calendarFirstDayOfWeek: 0,
                isCalendarLoading: false,

                slots: [],
                slotFilter: 'all',
                isSlotsLoading: false,
                availableSlotsCount: 0,
                showPastSlots: false,

                form: {
                    customer_name: '',
                    customer_email: '',
                    customer_phone: '',
                    customer_notes: '',
                    honeypot: ''
                },
                isSubmittingBooking: false,
                bookingErrorMessage: null,

                // Review & Confirmation
                isReviewModalOpen: false,
                isConfirmationModalOpen: false,
                confirmedAppointment: null,
                confirmedManageUrl: '',
                confirmedAppointmentGoogleUrl: '',
                manageCopied: false,

                // Lookup modal
                isLookupModalOpen: false,
                lookupRefCode: '',
                lookupContact: '',
                isLookingUp: false,
                lookupError: null,
                foundAppointment: null,

                // Guest Self-Service Manage
                isGuestManageModalOpen: false,
                guestAppointment: null,
                guestAppointmentCanBeModified: false,
                guestGoogleUrl: '',
                isRescheduleActive: false,
                rescheduleNewDateTime: '',

                // Priority Waitlist
                isWaitlistModalOpen: false,
                waitlistForm: {
                    preferred_time: 'anytime',
                    customer_name: '',
                    customer_email: '',
                    customer_phone: ''
                },

                // Live Queue Board
                nowServingData: {
                    date: '',
                    serving: [],
                    next_up: [],
                    total_serving: 0,
                    total_waiting: 0
                },
                queueBoardDate: '',
                queuePollInterval: null,

                // Admin
                adminDate: '<%- currentDate %>',
                adminProviderId: '',
                adminStatusFilter: 'all',
                adminSearchQuery: '',
                adminAppointments: [],
                adminStats: {
                    total_bookings: 0,
                    completed: 0,
                    capacity_percentage: 0,
                    revenue_today: 0,
                    waitlist_count: 0
                },
                isBlockTimeModalOpen: false,
                blockTimeForm: {
                    provider_id: '',
                    title: '',
                    starts_at: '',
                    ends_at: ''
                },

                // Notifications
                isNotificationDrawerOpen: false,
                notifications: [
                    {
                        channel: 'email',
                        subject: 'Guest Booking System Ready (Node.js)',
                        body: 'No account required. Select a service, date, and time slot to generate your daily queue number.',
                        time: 'Just now'
                    }
                ],

                initApp() {
                    if (this.services.length > 0) {
                        this.selectedService = this.services[0];
                    }
                    this.updateMonthName();
                    this.loadCalendarSummary();

                    // If user arrived with a manage link
                    if (this.initialManageToken) {
                        this.loadGuestAppointmentByToken(this.initialManageToken);
                    }
                },

                switchView(view) {
                    this.activeView = view;
                    if (view === 'admin') {
                        this.loadAdminData();
                    } else if (view === 'queue') {
                        this.loadNowServingData();
                    }
                },

                getInitials(name) {
                    if (!name) return 'SP';
                    return name.replace(/^Dr\.\s*/i, '')
                               .split(' ')
                               .filter(Boolean)
                               .map(n => n[0])
                               .slice(0, 2)
                               .join('');
                },

                updateMonthName() {
                    const date = new Date(this.calendarYear, this.calendarMonth - 1, 1);
                    this.calendarMonthName = date.toLocaleString('default', { month: 'long' });
                },

                prevMonth() {
                    if (this.calendarMonth === 1) {
                        this.calendarMonth = 12;
                        this.calendarYear--;
                    } else {
                        this.calendarMonth--;
                    }
                    this.updateMonthName();
                    this.loadCalendarSummary();
                },

                nextMonth() {
                    if (this.calendarMonth === 12) {
                        this.calendarMonth = 1;
                        this.calendarYear++;
                    } else {
                        this.calendarMonth++;
                    }
                    this.updateMonthName();
                    this.loadCalendarSummary();
                },

                selectService(service) {
                    this.selectedService = service;
                    this.selectedSlot = null;
                    this.loadCalendarSummary();
                },

                selectProvider(provider) {
                    this.selectedProvider = provider;
                    this.selectedSlot = null;
                    this.loadCalendarSummary();
                },

                onTimezoneChange() {
                    this.loadCalendarSummary();
                    if (this.selectedDate) {
                        this.loadSlots();
                    }
                },

                async loadCalendarSummary() {
                    if (!this.selectedService) return;
                    this.isCalendarLoading = true;
                    try {
                        const params = new URLSearchParams({
                            service_id: this.selectedService.id,
                            year: this.calendarYear,
                            month: this.calendarMonth,
                            timezone: this.selectedTimezone
                        });
                        if (this.selectedProvider) {
                            params.append('provider_id', this.selectedProvider.id);
                        }

                        const res = await fetch(`/api/calendar-summary?${params.toString()}`);
                        const data = await res.json();
                        if (data.success) {
                            this.calendarDays = data.summary;
                            this.buildCalendarGrid();

                            // Pre-select first open slot date
                            const availableDay = Object.values(this.calendarDays).find(d => !d.is_past && (d.status === 'available' || d.status === 'few_left'));
                            if (availableDay && !this.selectedDate) {
                                this.selectDate(availableDay);
                            }
                        }
                    } catch (e) {
                        console.error('Failed to load calendar summary', e);
                    } finally {
                        this.isCalendarLoading = false;
                    }
                },

                buildCalendarGrid() {
                    const firstDate = new Date(this.calendarYear, this.calendarMonth - 1, 1);
                    const startDayOfWeek = firstDate.getDay();
                    const list = [];

                    for (let i = 0; i < startDayOfWeek; i++) {
                        list.push({ isBlank: true });
                    }

                    const daysInMonth = new Date(this.calendarYear, this.calendarMonth, 0).getDate();
                    for (let d = 1; d <= daysInMonth; d++) {
                        const dateStr = `${this.calendarYear}-${String(this.calendarMonth).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                        const dayData = this.calendarDays[dateStr] || {
                            date: dateStr,
                            status: 'available',
                            is_past: false,
                            available_slots: 8
                        };

                        list.push({
                            isBlank: false,
                            dayNum: d,
                            date: dateStr,
                            status: dayData.status,
                            clickable: !dayData.is_past && dayData.status !== 'holiday' && dayData.status !== 'closed',
                            holiday_name: dayData.holiday_name || ''
                        });
                    }

                    this.calendarDaysList = list;
                },

                getDayTitle(day) {
                    if (day.status === 'holiday') return `Holiday: ${day.holiday_name}`;
                    if (day.status === 'past') return 'Past date';
                    if (day.status === 'closed') return 'Closed';
                    if (day.status === 'full') return 'Fully booked (Join waitlist)';
                    return 'Open slots available';
                },

                getDayClass(day) {
                    if (this.selectedDate === day.date) {
                        return 'bg-teal-600 text-white font-bold ring-2 ring-teal-600 shadow-xs';
                    }
                    if (day.status === 'past') {
                        return 'text-slate-300 bg-slate-50 cursor-not-allowed opacity-60';
                    }
                    if (day.status === 'holiday') {
                        return 'text-rose-400 bg-rose-50/50 cursor-not-allowed';
                    }
                    if (day.status === 'closed') {
                        return 'text-slate-300 bg-slate-50/50 cursor-not-allowed';
                    }
                    if (day.status === 'full') {
                        return 'text-slate-400 bg-slate-100 hover:bg-slate-200 cursor-pointer';
                    }
                    if (day.status === 'few_left') {
                        return 'text-slate-900 bg-amber-50 hover:bg-amber-100 border border-amber-200 cursor-pointer font-semibold';
                    }
                    return 'text-slate-800 bg-white hover:bg-teal-50 hover:text-teal-900 border border-slate-200 cursor-pointer';
                },

                selectDate(dayInfo) {
                    this.selectedDate = dayInfo.date;
                    const d = new Date(dayInfo.date + 'T00:00:00');
                    this.formattedSelectedDate = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
                    this.selectedSlot = null;
                    this.loadSlots();
                },

                async loadSlots() {
                    if (!this.selectedService || !this.selectedDate) return;
                    this.isSlotsLoading = true;
                    try {
                        const params = new URLSearchParams({
                            service_id: this.selectedService.id,
                            date: this.selectedDate,
                            timezone: this.selectedTimezone
                        });
                        if (this.selectedProvider) {
                            params.append('provider_id', this.selectedProvider.id);
                        }

                        const res = await fetch(`/api/slots?${params.toString()}`);
                        const data = await res.json();
                        if (data.success) {
                            this.slots = data.data.slots || [];
                            this.availableSlotsCount = data.data.available_count || 0;
                        }
                    } catch (e) {
                        console.error('Failed to load slots', e);
                    } finally {
                        this.isSlotsLoading = false;
                    }
                },

                get displaySlots() {
                    let list = this.slots;
                    if (this.slotFilter !== 'all') {
                        list = list.filter(s => s.period === this.slotFilter);
                    }
                    if (!this.showPastSlots) {
                        list = list.filter(s => !(s.reason && s.reason.includes('lead time')));
                    }
                    return list;
                },

                get pastLeadTimeSlotsCount() {
                    return this.slots.filter(s => !s.available && s.reason && s.reason.includes('lead time')).length;
                },

                getSlotClass(slot) {
                    if (this.selectedSlot?.datetime === slot.datetime) {
                        return 'bg-teal-600 text-white font-bold ring-2 ring-teal-500 shadow-xs';
                    }
                    if (!slot.available) {
                        return 'bg-slate-100 text-slate-400 border border-slate-200 cursor-not-allowed line-through text-[11px]';
                    }
                    return 'bg-white hover:bg-teal-50 hover:border-teal-400 text-slate-800 border border-slate-200 cursor-pointer shadow-2xs';
                },

                selectSlot(slot) {
                    if (!slot.available) return;
                    this.selectedSlot = slot;
                    this.bookingErrorMessage = null;
                },

                openReviewModal() {
                    if (!this.selectedService || !this.selectedSlot) return;
                    this.isReviewModalOpen = true;
                },

                // Booking Submission
                async submitBooking() {
                    this.isSubmittingBooking = true;
                    this.bookingErrorMessage = null;
                    try {
                        const payload = {
                            service_id: this.selectedService.id,
                            provider_id: this.selectedSlot.provider_id,
                            starts_at: this.selectedSlot.datetime,
                            customer_name: this.form.customer_name,
                            customer_email: this.form.customer_email,
                            customer_phone: this.form.customer_phone,
                            customer_notes: this.form.customer_notes,
                            timezone: this.selectedTimezone,
                            is_recurring: this.isRecurring,
                            recurring_weeks: this.recurringWeeks,
                            honeypot: this.form.honeypot
                        };

                        const res = await fetch('/api/appointments', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            this.bookingErrorMessage = data.message || 'Unable to schedule appointment. Please try another slot.';
                            this.isReviewModalOpen = false;
                            return;
                        }

                        this.confirmedAppointment = data.appointment;
                        this.confirmedManageUrl = data.manage_url || window.location.origin + '/manage/' + data.appointment.manage_token;
                        this.confirmedAppointmentGoogleUrl = data.google_calendar_url;
                        this.isReviewModalOpen = false;
                        this.isConfirmationModalOpen = true;

                        // Push simulated email and SMS to notifications
                        const formattedDate = new Date(data.appointment.starts_at).toLocaleString();
                        this.notifications.unshift({
                            channel: 'email',
                            subject: `Booking Confirmed: Queue #${data.appointment.queue_number} (${data.appointment.reference_code})`,
                            body: `Dear ${data.appointment.customer_name},\nYour appointment for ${data.appointment.service.name} is confirmed for ${formattedDate}.\nQueue Ticket: ${data.appointment.queue_number}\n\nManage your booking anytime (no login): ${this.confirmedManageUrl}`,
                            time: 'Just now'
                        });

                        this.notifications.unshift({
                            channel: 'sms',
                            subject: `Queue #${data.appointment.queue_number} Confirmed`,
                            body: `Lumina Health: Your appointment is set for ${formattedDate}. Queue: ${data.appointment.queue_number}. Manage: ${this.confirmedManageUrl}`,
                            time: 'Just now'
                        });

                        this.loadSlots();
                    } catch (e) {
                        this.bookingErrorMessage = 'A network error occurred while booking.';
                        this.isReviewModalOpen = false;
                    } finally {
                        this.isSubmittingBooking = false;
                    }
                },

                copyManageUrl() {
                    navigator.clipboard.writeText(this.confirmedManageUrl);
                    this.manageCopied = true;
                    setTimeout(() => { this.manageCopied = false; }, 2500);
                },

                resetBookingFlow() {
                    this.selectedSlot = null;
                    this.form.customer_notes = '';
                    this.mobileStep = 1;
                },

                // Lookup Modal
                openLookupModal() {
                    this.isLookupModalOpen = true;
                    this.lookupError = null;
                    this.foundAppointment = null;
                },

                async performLookup() {
                    if (!this.lookupRefCode.trim() || !this.lookupContact.trim()) return;
                    this.isLookingUp = true;
                    this.lookupError = null;
                    this.foundAppointment = null;
                    try {
                        const res = await fetch('/api/appointments/lookup', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                reference_code: this.lookupRefCode.trim(),
                                contact: this.lookupContact.trim()
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.foundAppointment = data.appointment;
                        } else {
                            this.lookupError = data.message || 'No matching appointment found.';
                        }
                    } catch (e) {
                        this.lookupError = 'Error communicating with lookup service.';
                    } finally {
                        this.isLookingUp = false;
                    }
                },

                openManageModalFromAppointment(apt) {
                    this.isLookupModalOpen = false;
                    this.loadGuestAppointmentByToken(apt.manage_token);
                },

                // Guest Self-Service (No Login)
                async loadGuestAppointmentByToken(token) {
                    try {
                        const res = await fetch(`/api/manage/${token}`);
                        const data = await res.json();
                        if (data.success) {
                            this.guestAppointment = data.appointment;
                            this.guestAppointmentCanBeModified = data.can_be_modified;
                            this.guestGoogleUrl = data.google_calendar_url;
                            this.isGuestManageModalOpen = true;
                        }
                    } catch (e) {
                        alert('Unable to load appointment management details.');
                    }
                },

                async confirmReschedule() {
                    if (!this.rescheduleNewDateTime) {
                        alert('Please pick a new date and time.');
                        return;
                    }
                    try {
                        const res = await fetch(`/api/manage/${this.guestAppointment.manage_token}/reschedule`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                starts_at: this.rescheduleNewDateTime
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            alert(`Appointment rescheduled! New Queue Ticket: ${data.appointment.queue_number}`);
                            this.guestAppointment = data.appointment;
                            this.isRescheduleActive = false;
                            this.loadSlots();
                        } else {
                            alert(data.message || 'Rescheduling failed.');
                        }
                    } catch (e) {
                        alert('Error rescheduling appointment.');
                    }
                },

                async cancelGuestBooking() {
                    if (!confirm('Are you sure you want to cancel this booking? Your reserved slot will be immediately returned to the pool.')) return;
                    try {
                        const res = await fetch(`/api/manage/${this.guestAppointment.manage_token}/cancel`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                cancellation_reason: 'Cancelled by guest via self-service portal'
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            alert('Your booking has been cancelled and the slot returned to the pool.');
                            this.guestAppointment.status = 'cancelled';
                            this.loadSlots();
                        } else {
                            alert(data.message || 'Cancellation failed.');
                        }
                    } catch (e) {
                        alert('Error cancelling booking.');
                    }
                },

                // Priority Waitlist
                openWaitlistModal() {
                    this.isWaitlistModalOpen = true;
                },

                async submitWaitlist() {
                    try {
                        const res = await fetch('/api/waitlist', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                service_id: this.selectedService.id,
                                provider_id: this.selectedProvider?.id || null,
                                requested_date: this.selectedDate,
                                preferred_time: this.waitlistForm.preferred_time,
                                customer_name: this.waitlistForm.customer_name,
                                customer_email: this.waitlistForm.customer_email,
                                customer_phone: this.waitlistForm.customer_phone
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            alert('You have joined the priority waitlist!');
                            this.isWaitlistModalOpen = false;
                        } else {
                            alert(data.message || 'Could not join waitlist.');
                        }
                    } catch (e) {
                        alert('Error joining waitlist.');
                    }
                },

                // "Now Serving" Live Queue Board
                async loadNowServingData() {
                    try {
                        const res = await fetch('/api/queue/now-serving');
                        const data = await res.json();
                        if (data.success) {
                            this.nowServingData = data.data;
                            this.queueBoardDate = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' });
                        }
                    } catch (e) {
                        console.error('Failed to load now serving queue data', e);
                    }
                },

                // Admin Operations
                async loadAdminData() {
                    try {
                        const statsRes = await fetch(`/api/admin/stats?date=${this.adminDate}`);
                        const statsData = await statsRes.json();
                        if (statsData.success) {
                            this.adminStats = statsData;
                        }

                        const aptParams = new URLSearchParams({ date: this.adminDate });
                        if (this.adminProviderId) aptParams.append('provider_id', this.adminProviderId);
                        if (this.adminStatusFilter !== 'all') aptParams.append('status', this.adminStatusFilter);
                        if (this.adminSearchQuery) aptParams.append('search', this.adminSearchQuery);

                        const aptRes = await fetch(`/api/admin/appointments?${aptParams.toString()}`);
                        const aptData = await aptRes.json();
                        if (aptData.success) {
                            this.adminAppointments = aptData.appointments;
                        }
                    } catch (e) {
                        console.error('Failed to load admin data', e);
                    }
                },

                async updateAppointmentStatus(id, status) {
                    try {
                        const res = await fetch(`/api/admin/appointments/${id}/status`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({ status })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.loadAdminData();
                        } else {
                            alert(data.message || 'Could not update status.');
                        }
                    } catch (e) {
                        alert('Error updating status.');
                    }
                },

                async submitBlockTime() {
                    try {
                        const res = await fetch('/api/admin/blocked-times', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(this.blockTimeForm)
                        });
                        const data = await res.json();
                        if (data.success) {
                            alert('Time window successfully blocked.');
                            this.isBlockTimeModalOpen = false;
                            this.loadAdminData();
                            this.loadSlots();
                        } else {
                            alert(data.message || 'Error blocking time.');
                        }
                    } catch (e) {
                        alert('Error blocking time.');
                    }
                },

                formatCurrency(amount) {
                    if (amount === null || amount === undefined || isNaN(amount)) return '₱0.00';
                    return '₱' + Number(amount).toLocaleString('en-PH', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                },

                formatTimeWindow(start, end) {
                    if (!start || !end) return '';
                    const s = new Date(start);
                    const e = new Date(end);
                    return s.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) + ' - ' + e.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                },

                formatDateTime(dateStr) {
                    if (!dateStr) return '';
                    const d = new Date(dateStr);
                    return d.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) + ' at ' + d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                },

                getStatusBadgeClass(status) {
                    switch (status) {
                        case 'serving':
                            return 'bg-emerald-500 text-white animate-pulse';
                        case 'confirmed':
                            return 'bg-teal-100 text-teal-800';
                        case 'completed':
                            return 'bg-emerald-100 text-emerald-800';
                        case 'cancelled':
                            return 'bg-rose-100 text-rose-800';
                        case 'no_show':
                            return 'bg-amber-100 text-amber-800';
                        default:
                            return 'bg-slate-100 text-slate-700';
                    }
                }
            };
        }
    </script>
