<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 text-slate-900 antialiased">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="node-scheduler-token">

    <title>Lumina Health & Performance | Appointment Scheduler (Node.js)</title>

    <link rel="preconnect" href="https://fonts.bunny.net">
    <link rel="stylesheet" href="/build/assets/app-BvAYcH-z.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 lg:h-screen lg:overflow-hidden"
      x-data="schedulerApp()"
      x-init="initApp()">

    <!-- Header (Responsive) -->
    <header class="shrink-0 bg-white/95 backdrop-blur border-b border-slate-200 z-30">
        <div class="h-12 max-w-7xl mx-auto px-3 flex items-center justify-between">
            
            <!-- Brand -->
            <div class="flex items-center space-x-2">
                <div class="w-7 h-7 rounded-lg bg-teal-600 flex items-center justify-center text-white shadow-xs">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                </div>
                <div class="flex items-center space-x-1.5">
                    <span class="font-bold text-sm tracking-tight text-slate-900">Lumina Health</span>
                    <span class="hidden sm:inline-block text-[10px] font-semibold px-1.5 py-0.2 rounded bg-teal-50 text-teal-700 border border-teal-200">Node.js Engine</span>
                </div>
            </div>

            <!-- View toggle (Desktop / Tablet: sm+) -->
            <div class="hidden sm:flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200">
                <button type="button"
                        @click="switchView('client')"
                        :class="activeView === 'client' ? 'bg-white text-teal-700 shadow-xs font-semibold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                        class="px-2.5 py-1 rounded-md text-xs transition flex items-center space-x-1">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span>Book Schedule</span>
                </button>
                <button type="button"
                        @click="switchView('queue')"
                        :class="activeView === 'queue' ? 'bg-white text-teal-700 shadow-xs font-semibold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                        class="px-2.5 py-1 rounded-md text-xs transition flex items-center space-x-1">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>Now Serving</span>
                </button>
                <button type="button"
                        @click="switchView('admin')"
                        :class="activeView === 'admin' ? 'bg-white text-teal-700 shadow-xs font-semibold' : 'text-slate-600 hover:text-slate-900 font-medium'"
                        class="px-2.5 py-1 rounded-md text-xs transition flex items-center space-x-1">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span>Admin Operations</span>
                </button>
            </div>

            <!-- Header actions -->
            <div class="flex items-center space-x-2">
                <div class="relative hidden md:flex items-center text-[11px] text-slate-600 bg-slate-50 border border-slate-200 rounded-md px-2 py-1">
                    <svg class="w-3 h-3 mr-1 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <select x-model="selectedTimezone" @change="onTimezoneChange()" class="bg-transparent border-0 text-[11px] text-slate-700 font-medium focus:ring-0 cursor-pointer p-0">
                        <option value="UTC">UTC</option>
                        <option value="America/New_York">US Eastern (ET)</option>
                        <option value="America/Chicago">US Central (CT)</option>
                        <option value="America/Los_Angeles">US Pacific (PT)</option>
                        <option value="Europe/London">London (GMT/BST)</option>
                        <option value="Asia/Tokyo">Tokyo (JST)</option>
                        <option value="Asia/Shanghai">Beijing / Shanghai (CST)</option>
                        <option value="Australia/Sydney">Sydney (AEST)</option>
                    </select>
                </div>

                <button type="button"
                        @click="openLookupModal()"
                        title="Look up a booking without login"
                        class="px-2.5 py-1 text-xs font-medium text-slate-700 bg-white border border-slate-300 rounded-md hover:bg-slate-50 transition shadow-2xs flex items-center space-x-1">
                    <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>Lookup</span>
                </button>

                <button type="button"
                        @click="isNotificationDrawerOpen = true"
                        title="Simulated Alerts (Email / SMS)"
                        class="relative p-1.5 text-slate-500 hover:text-slate-800 bg-white border border-slate-200 rounded-md hover:bg-slate-50 transition">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <span x-show="notifications.length > 0"
                          x-text="notifications.length"
                          class="absolute -top-1 -right-1 flex h-3.5 w-3.5 items-center justify-center rounded-full bg-teal-600 text-[8px] font-bold text-white ring-1 ring-white"></span>
                </button>
            </div>
        </div>

        <!-- Mobile Segmented View Control (< sm screens) -->
        <div class="px-3 pb-2 sm:hidden">
            <div class="grid grid-cols-3 w-full bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-xs">
                <button type="button"
                        @click="switchView('client')"
                        :class="activeView === 'client' ? 'bg-white text-teal-700 shadow-xs font-bold' : 'text-slate-600 font-medium'"
                        class="py-1 rounded-md text-xs transition flex items-center justify-center space-x-1">
                    <span>Book</span>
                </button>
                <button type="button"
                        @click="switchView('queue')"
                        :class="activeView === 'queue' ? 'bg-white text-teal-700 shadow-xs font-bold' : 'text-slate-600 font-medium'"
                        class="py-1 rounded-md text-xs transition flex items-center justify-center space-x-1">
                    <span>Now Serving</span>
                </button>
                <button type="button"
                        @click="switchView('admin')"
                        :class="activeView === 'admin' ? 'bg-white text-teal-700 shadow-xs font-bold' : 'text-slate-600 font-medium'"
                        class="py-1 rounded-md text-xs transition flex items-center justify-center space-x-1">
                    <span>Admin</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Viewport -->
    <main class="flex-1 w-full max-w-7xl mx-auto p-2.5 sm:p-3 overflow-y-auto lg:overflow-hidden pb-24 lg:pb-3">
        
        <!-- ==================================================================== -->
        <!-- 1. GUEST BOOKING WORKFLOW (No Login)                                 -->
        <!-- ==================================================================== -->
        <div x-show="activeView === 'client'" class="h-full flex flex-col justify-start">
            
            <!-- Mobile Step Progress Stepper (< lg screens) -->
            <div class="lg:hidden mb-2.5 bg-white p-2 rounded-xl border border-slate-200 shadow-2xs shrink-0">
                <div class="grid grid-cols-3 gap-1.5">
                    <button type="button"
                            @click="mobileStep = 1"
                            :class="mobileStep === 1 ? 'bg-teal-600 text-white font-bold shadow-xs' : (mobileStep > 1 ? 'bg-teal-50 text-teal-800 font-semibold border border-teal-200' : 'bg-slate-50 text-slate-500 font-medium')"
                            class="py-2 px-1 rounded-lg text-xs flex items-center justify-center space-x-1.5 transition">
                        <span class="w-4 h-4 rounded-full flex items-center justify-center text-[10px]"
                              :class="mobileStep === 1 ? 'bg-white/20 text-white' : (mobileStep > 1 ? 'bg-teal-200 text-teal-900 font-bold' : 'bg-slate-200 text-slate-600')">
                            <template x-if="mobileStep > 1"><span>✓</span></template>
                            <template x-if="mobileStep <= 1"><span>1</span></template>
                        </span>
                        <span class="truncate">Service</span>
                    </button>

                    <button type="button"
                            @click="mobileStep = 2"
                            :class="mobileStep === 2 ? 'bg-teal-600 text-white font-bold shadow-xs' : (mobileStep > 2 ? 'bg-teal-50 text-teal-800 font-semibold border border-teal-200' : 'bg-slate-50 text-slate-500 font-medium')"
                            class="py-2 px-1 rounded-lg text-xs flex items-center justify-center space-x-1.5 transition">
                        <span class="w-4 h-4 rounded-full flex items-center justify-center text-[10px]"
                              :class="mobileStep === 2 ? 'bg-white/20 text-white' : (mobileStep > 2 ? 'bg-teal-200 text-teal-900 font-bold' : 'bg-slate-200 text-slate-600')">
                            <template x-if="mobileStep > 2"><span>✓</span></template>
                            <template x-if="mobileStep <= 2"><span>2</span></template>
                        </span>
                        <span class="truncate">Schedule</span>
                    </button>

                    <button type="button"
                            @click="selectedSlot && (mobileStep = 3)"
                            :disabled="!selectedSlot"
                            :class="mobileStep === 3 ? 'bg-teal-600 text-white font-bold shadow-xs' : (!selectedSlot ? 'bg-slate-50 text-slate-400 opacity-60 cursor-not-allowed' : 'bg-slate-50 text-slate-700 font-medium')"
                            class="py-2 px-1 rounded-lg text-xs flex items-center justify-center space-x-1.5 transition">
                        <span class="w-4 h-4 rounded-full flex items-center justify-center text-[10px]"
                              :class="mobileStep === 3 ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-600'">3</span>
                        <span class="truncate">Details</span>
                    </button>
                </div>
            </div>

            <!-- Booking Columns Grid -->
            <div class="flex-1 lg:h-full grid grid-cols-1 lg:grid-cols-12 gap-3 items-stretch">
                
                <!-- Column 1 (3 cols): Service & Provider Selection -->
                <section :class="mobileStep === 1 ? 'flex' : 'hidden lg:flex'"
                         class="lg:col-span-3 bg-white rounded-xl border border-slate-200 p-3 sm:p-3.5 flex-col justify-between shadow-2xs overflow-y-auto">
                    <div class="space-y-3">
                        
                        <!-- Step Header -->
                        <div class="border-b border-slate-100 pb-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full">Step 1: Service</span>
                                <span class="text-[10px] text-slate-400">Guest Access</span>
                            </div>
                            <h2 class="text-sm font-bold text-slate-900 mt-1">Select Care Service</h2>
                        </div>

                        <!-- Services list -->
                        <div class="space-y-2">
                            <template x-for="service in services" :key="service.id">
                                <div @click="selectService(service)"
                                     :class="selectedService?.id === service.id ? 'border-teal-600 bg-teal-50/40 ring-2 ring-teal-600/30' : 'border-slate-200 hover:border-slate-300 bg-white'"
                                     class="p-3 rounded-xl border cursor-pointer transition shadow-2xs">
                                    <div class="flex items-center justify-between">
                                        <div class="font-bold text-xs text-slate-900" x-text="service.name"></div>
                                        <span class="text-xs font-bold text-teal-700" x-text="formatCurrency(service.price)"></span>
                                    </div>
                                    <div class="flex items-center space-x-2 text-[10px] text-slate-500 mt-1">
                                        <span>⏱ <span x-text="service.duration_minutes"></span>m duration</span>
                                        <span>•</span>
                                        <span>+<span x-text="service.buffer_minutes"></span>m buffer</span>
                                    </div>
                                    <div x-show="selectedService?.id === service.id" x-transition class="mt-2 pt-2 border-t border-slate-200/60 text-[11px] text-slate-600 leading-relaxed" x-text="service.description"></div>
                                </div>
                            </template>
                        </div>

                        <!-- Provider selector -->
                        <div class="pt-2 border-t border-slate-100">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block mb-1.5">Provider Preference</span>
                            <div class="space-y-1.5">
                                <div @click="selectProvider(null)"
                                     :class="selectedProvider === null ? 'border-teal-600 bg-teal-50/50 ring-1 ring-teal-600 font-semibold' : 'border-slate-200 bg-white hover:bg-slate-50'"
                                     class="p-2 rounded-lg border text-xs flex items-center justify-between cursor-pointer transition">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 font-bold text-[10px] flex items-center justify-center">ANY</div>
                                        <span class="text-xs">First Available Provider</span>
                                    </div>
                                    <span x-show="selectedProvider === null" class="text-teal-700 font-bold text-xs">✓</span>
                                </div>

                                <template x-for="provider in providers" :key="provider.id">
                                    <div @click="selectProvider(provider)"
                                         :class="selectedProvider?.id === provider.id ? 'border-teal-600 bg-teal-50/50 ring-1 ring-teal-600 font-semibold' : 'border-slate-200 bg-white hover:bg-slate-50'"
                                         class="p-2 rounded-lg border text-xs flex items-center justify-between cursor-pointer transition">
                                        <div class="flex items-center space-x-2 truncate">
                                            <div class="w-6 h-6 rounded-full bg-teal-100 text-teal-800 font-bold text-[9px] flex items-center justify-center shrink-0" x-text="getInitials(provider.name)"></div>
                                            <div class="truncate">
                                                <div class="text-xs truncate font-medium" x-text="provider.name"></div>
                                                <div class="text-[9px] text-slate-400 truncate" x-text="provider.title"></div>
                                            </div>
                                        </div>
                                        <span x-show="selectedProvider?.id === provider.id" class="text-teal-700 font-bold text-xs shrink-0">✓</span>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>

                    <!-- Recurring Booking Toggle & Mobile Continue Button -->
                    <div class="pt-2 border-t border-slate-100 mt-2 space-y-2">
                        <label class="flex items-center space-x-2 cursor-pointer text-xs">
                            <input type="checkbox" x-model="isRecurring" class="rounded text-teal-600 focus:ring-teal-500 border-slate-300">
                            <span class="font-medium text-slate-700">Recurring appointment</span>
                        </label>
                        <div x-show="isRecurring" x-transition class="flex items-center justify-between text-xs">
                            <span class="text-slate-500 text-[11px]">Repeat weekly for:</span>
                            <select x-model="recurringWeeks" class="text-xs py-0.5 border-slate-300 rounded">
                                <option value="2">2 weeks</option>
                                <option value="3">3 weeks</option>
                                <option value="4">4 weeks</option>
                            </select>
                        </div>

                        <!-- Mobile continue button for Step 1 -->
                        <div class="lg:hidden pt-2">
                            <button type="button"
                                    @click="mobileStep = 2"
                                    class="w-full py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs rounded-xl shadow-xs flex items-center justify-center space-x-1.5 transition">
                                <span>Continue to Choose Date & Slot</span>
                                <span>→</span>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Column 2 (5 cols): Calendar Picker + Guest Details Form -->
                <section :class="(mobileStep === 2 || mobileStep === 3) ? 'flex' : 'hidden lg:flex'"
                         class="lg:col-span-5 bg-white rounded-xl border border-slate-200 p-3 sm:p-3.5 flex-col space-y-2.5 shadow-2xs overflow-y-auto">
                    
                    <!-- Calendar Section (Visible on Mobile Step 2 & Desktop Always) -->
                    <div :class="mobileStep === 2 ? 'block' : 'hidden lg:block'" class="space-y-2">
                        
                        <!-- Calendar Header -->
                        <div class="flex items-center justify-between pb-1 border-b border-slate-100">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full">Step 2: Pick Date</span>
                                <h2 class="text-xs font-bold text-slate-900 mt-0.5" x-text="calendarMonthName + ' ' + calendarYear"></h2>
                            </div>
                            <div class="flex items-center space-x-1">
                                <button type="button" @click="prevMonth()" class="px-2 py-1 rounded hover:bg-slate-100 text-slate-600 text-xs font-semibold">‹ Prev</button>
                                <button type="button" @click="nextMonth()" class="px-2 py-1 rounded hover:bg-slate-100 text-slate-600 text-xs font-semibold">Next ›</button>
                            </div>
                        </div>

                        <!-- Mini Calendar Grid -->
                        <div class="relative">
                            <div x-show="isCalendarLoading" class="absolute inset-0 bg-white/70 backdrop-blur-[1px] flex items-center justify-center z-10">
                                <span class="text-xs font-semibold text-teal-700">Updating calendar...</span>
                            </div>

                            <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-slate-400 mb-1">
                                <div>Su</div><div>Mo</div><div>Tu</div><div>We</div><div>Th</div><div>Fr</div><div>Sa</div>
                            </div>

                            <div class="grid grid-cols-7 gap-1">
                                <template x-for="(dayItem, idx) in calendarDaysList" :key="idx">
                                    <div class="text-center">
                                        <div x-show="dayItem.isBlank" class="h-9 sm:h-8"></div>
                                        <button x-show="!dayItem.isBlank"
                                                type="button"
                                                @click="dayItem.clickable && selectDate(dayItem)"
                                                :disabled="!dayItem.clickable"
                                                :class="getDayClass(dayItem)"
                                                :title="getDayTitle(dayItem)"
                                                class="w-full h-9 sm:h-8 rounded-lg text-xs flex flex-col items-center justify-center transition relative">
                                            <span x-text="dayItem.dayNum"></span>
                                            <span x-show="dayItem.status === 'few_left' && selectedDate !== dayItem.date" class="w-1.5 h-1.5 rounded-full bg-amber-400" title="Few slots left"></span>
                                            <span x-show="dayItem.status === 'holiday'" class="w-1.5 h-1.5 rounded-full bg-rose-400" title="Holiday"></span>
                                            <span x-show="dayItem.status === 'full'" class="text-[7px] font-bold text-slate-400">Full</span>
                                        </button>
                                    </div>
                                </template>
                            </div>
                        </div>

                        <!-- Calendar Legend -->
                        <div class="flex items-center justify-between text-[10px] text-slate-500 pt-1 border-t border-slate-100">
                            <div class="flex items-center space-x-2">
                                <span class="flex items-center space-x-1">
                                    <span class="w-2 h-2 rounded-full bg-teal-600 inline-block"></span>
                                    <span>Open</span>
                                </span>
                                <span class="flex items-center space-x-1">
                                    <span class="w-2 h-2 rounded-full bg-amber-400 inline-block"></span>
                                    <span>Few slots</span>
                                </span>
                                <span class="flex items-center space-x-1">
                                    <span class="w-2 h-2 rounded-full bg-rose-400 inline-block"></span>
                                    <span>Holiday</span>
                                </span>
                            </div>
                            <span class="text-[10px] text-slate-400">Dimmed = Closed/Full</span>
                        </div>

                        <!-- Selected Date & Availability Prompt -->
                        <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5 flex items-center justify-between text-xs">
                            <div class="flex items-center space-x-2 truncate">
                                <div class="w-7 h-7 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center font-bold text-xs shrink-0">
                                    📅
                                </div>
                                <div class="truncate">
                                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide block">Selected Date</span>
                                    <span class="font-bold text-slate-800 truncate block" x-text="formattedSelectedDate || 'Please select a date'"></span>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-700 border border-teal-200">
                                    <span x-text="availableSlotsCount"></span>&nbsp;open slots
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Summary & Guest Form (Visible on Mobile Step 3 & Desktop Always) -->
                    <div :class="mobileStep === 3 ? 'block' : 'hidden lg:block'" class="pt-2 lg:border-t border-slate-200 space-y-2.5">
                        
                        <!-- Mobile Step 3 Header -->
                        <div class="lg:hidden flex items-center justify-between pb-1.5 border-b border-slate-100">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full">Step 3: Details</span>
                                <h3 class="text-xs font-bold text-slate-900 mt-0.5">Guest Information</h3>
                            </div>
                            <button type="button" @click="mobileStep = 2" class="text-xs font-semibold text-teal-700 hover:text-teal-800 flex items-center space-x-0.5">
                                <span>‹ Change Slot</span>
                            </button>
                        </div>

                        <!-- Summary Card -->
                        <div class="text-xs space-y-1 bg-slate-50 p-2.5 rounded-lg border border-slate-200 shadow-2xs">
                            <div class="flex justify-between text-slate-600">
                                <span>Service:</span>
                                <span class="font-bold text-slate-900" x-text="selectedService?.name || '—'"></span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Schedule:</span>
                                <span class="font-bold text-teal-700" x-text="(selectedSlot ? selectedSlot.formatted_time : 'Pick a time slot') + ' • ' + (selectedDate ? formattedSelectedDate : '')"></span>
                            </div>
